# Settings for Docker Compose. Copy this file to `.env` (git-ignored) and uncomment what you
# need; Compose reads `.env` automatically. A native `herald` does not read it.
#
# Every line is optional: the value shown is the default (or an example), and an empty value
# counts as unset. Variables exported in your shell win over `.env`.

# --- Build (change, then run `docker compose build`) ---

# Linux only: the container user must own the writable bind mounts (dataset/, models/, runs/,
# output/ and profiles/). Use your own ids (`id -u`, `id -g`) if writing to them fails with "Permission denied".
# Docker Desktop (macOS, Windows) maps ownership itself, so leave these alone there.
# HERALD_UID=1000
# HERALD_GID=1000

# NVIDIA GPU (Linux + NVIDIA Container Toolkit): use the GPU image, and give Ollama the GPU,
# without -f flags. Separate the files with `;` on Windows.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- Runtime: HERALD_* variables that Compose forwards to the container ---
# These are the settings that make sense to change from `.env`. The path variables
# (HERALD_PROJECT_ROOT, HERALD_MODELS_DIR, HERALD_CHECKPOINT_DIR, HERALD_RUNS_DIR,
# HERALD_OUTPUT_DIR, HERALD_TOOLS_DIR, HERALD_PROFILES_DIR) are not forwarded on purpose: the
# bind mounts fix those locations. In Docker, tools (./tools/*.py) and timers run inside the
# container, so a tool cannot reach programs of the host or files that are not mounted.

# The voice and character to use for synthesize/chat/train, e.g. frieren; see profiles/.
# HERALD_PROFILE=frieren

# Fine-tuned voice for `synthesize` and `chat`: a checkpoint file, or a directory holding
# best_model.pth, relative to the working directory (/app, the project root, in the container).
# While it is set there is no command line switch back to the base voice: comment it out
# (or leave it empty) to get the base XTTS-v2 voice.
# HERALD_CHECKPOINT=models/frieren

# Dataset for `train` and for the reference clips of the voice.
# HERALD_DATASET_DIR=dataset/frieren

# Language code passed to XTTS; device: auto, cpu, cuda or cuda:N.
# HERALD_LANGUAGE=en
# HERALD_DEVICE=auto

# The Ollama model must be pulled first: docker compose exec ollama ollama pull <model>
# The timeout is in seconds.
# HERALD_OLLAMA_MODEL=llama3.2:3b
# HERALD_OLLAMA_TIMEOUT=120

# `chat` needs an Ollama: the container (`docker compose up -d --wait ollama` first), or one
# running on the host, which needs no container at all. Worth it on macOS, where containers
# get no GPU.
# HERALD_OLLAMA_URL=http://host.docker.internal:11434

# Where `download-checkpoints` fetches the base weights from (a mirror).
# HERALD_CHECKPOINT_URL=https://example.com/xtts-v2

# The character of `chat`. Quote values with spaces. For a long prompt use
# `chat --system-prompt-file <file>` with a file inside one of the mounted directories.
# HERALD_SYSTEM_PROMPT="You are a grumpy wizard. Answer in one short sentence."
